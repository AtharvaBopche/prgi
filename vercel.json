{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{backend/app/**,backend/data/**,backend/database/master_database.db}",
      "excludeFiles": "{backend/tests/**,scratch/**,.pytest_cache/**,**/__pycache__/**}"
    }
  }
}
